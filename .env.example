# =============================================================================
# LLM Settings
# =============================================================================
# LLM Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# LLM Model name (e.g., "gpt-4o-mini", "llama3.1:8b")
LLM_MODEL=gpt-4o-mini

# LLM API Key (required for OpenAI, optional for Ollama if using local instance)
LLM_API_KEY=

# LLM Base URL (optional, for custom endpoints or Ollama local server)
# Example for Ollama: http://localhost:11434
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# =============================================================================
# Diffuser Settings (Video Generation)
# =============================================================================
# Backend: "svd" (Stable Video Diffusion) or "animatediff"
DIFFUSER_BACKEND=svd

# Device: "cuda" or "cpu"
DIFFUSER_DEVICE=cuda

# Data type: "float16" or "float32" (float16 uses less VRAM)
DIFFUSER_DTYPE=float16

# Video dimensions
DIFFUSER_WIDTH=740
DIFFUSER_HEIGHT=576

# Frames per second
DIFFUSER_FPS=5

# Random seed for reproducibility
DIFFUSER_SEED=42

# Enable CPU offloading to reduce VRAM usage (recommended for 6GB VRAM)
DIFFUSER_CPU_OFFLOAD=true

# =============================================================================
# SVD (Stable Video Diffusion) Settings
# =============================================================================
# SDXL model for generating keyframes (text-to-image)
# Example: "stabilityai/stable-diffusion-xl-base-1.0"
DIFFUSER_SDXL_MODEL_ID=runwayml/stable-diffusion-v1-5

# SVD model for video generation (image-to-video)
# Example: "stabilityai/stable-video-diffusion-img2vid-xt"
DIFFUSER_SVD_MODEL_ID=stabilityai/stable-video-diffusion-img2vid-xt

# Number of frames to generate per video segment
DIFFUSER_SVD_NUM_FRAMES=14

# Number of inference steps (more steps = better quality, slower)
DIFFUSER_SVD_NUM_STEPS=10

# Motion bucket ID (controls motion intensity: 1-255, higher = more motion)
DIFFUSER_SVD_MOTION_BUCKET=127

# Decode chunk size (lower = less VRAM usage, slower)
DIFFUSER_SVD_DECODE_CHUNK=2

# =============================================================================
# AnimateDiff Settings
# =============================================================================
# Base model ID for AnimateDiff
# Example: "runwayml/stable-diffusion-v1-5"
DIFFUSER_AD_BASE_MODEL_ID=frankjoshua/toonyou_beta6

# Motion adapter ID for AnimateDiff
# Example: "guoyww/animatediff-motion-adapter-v1-5-2"
DIFFUSER_AD_MOTION_ADAPTER_ID=guoyww/animatediff-motion-adapter-v1-5-2

# Number of inference steps
DIFFUSER_AD_STEPS=10

# Number of frames to generate
DIFFUSER_AD_FRAMES=16

# Guidance scale (higher = more adherence to prompt, typically 7.5-12.5)
DIFFUSER_AD_GUIDANCE=7.5