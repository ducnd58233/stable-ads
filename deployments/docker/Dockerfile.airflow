FROM apache/airflow:3.1.1-python3.13

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# First install setuptools to ensure pkg_resources is available
RUN pip install --no-cache-dir --upgrade setuptools

# Copy and install Python packages from requirements file
COPY deployments/docker/requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt

WORKDIR /opt/airflow/project
COPY core/ ./core/
COPY modules/ ./modules/

ENV PYTHONPATH=/opt/airflow/project