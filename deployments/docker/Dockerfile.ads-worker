FROM continuumio/miniconda3:latest AS base

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

FROM base AS conda-deps

COPY environment.yml /tmp/environment.yml
RUN conda env update -n base -f /tmp/environment.yml && \
    conda clean -afy

FROM conda-deps AS python-deps

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock /tmp/
WORKDIR /tmp
RUN uv pip install --system --no-cache --group core --group worker --group api --group ml

FROM python-deps AS app

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY core/ ./core/
COPY modules/ ./modules/
COPY apps/ ./apps/

RUN mkdir -p runs/datasets runs/models

WORKDIR /app

CMD ["uvicorn", "apps.worker.main:app", "--host", "0.0.0.0", "--port", "8001"]

